# Copy to .env and fill in real values. NEVER commit .env.
# In production the server refuses to start while JWT_SECRET, JWT_REFRESH_SECRET or SERVER_PEPPER
# are missing or still equal to the built-in development defaults.

NODE_ENV=production
PORT=3001

# PostgreSQL
DATABASE_URL=postgres://mjdm:CHANGE_ME@localhost:5432/mjdm_cloud

# 32+ random characters each, all different:  openssl rand -hex 48
JWT_SECRET=
JWT_REFRESH_SECRET=
SERVER_PEPPER=

# Browsers allowed to call the API with cookies (comma separated, exact origins)
CORS_ORIGINS=https://mjdm.us,https://admin.mjdm.us

# License signing key pair (ES256 / P-256, PEM). Keep the private key on the server only; the
# public key is embedded in the desktop app. If unset a random key is generated on every start,
# which invalidates every license issued before.
ES256_PRIVATE_KEY_PEM=
ES256_PUBLIC_KEY_PEM=

# Payment webhooks
LEMON_SQUEEZY_WEBHOOK_SECRET=
POLAR_WEBHOOK_SECRET=
