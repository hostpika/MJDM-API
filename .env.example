# Copy to .env and fill in real values. NEVER commit .env.
# In production the server refuses to start while JWT_SECRET, JWT_REFRESH_SECRET or SERVER_PEPPER
# are missing or still equal to the built-in development defaults.

NODE_ENV=production
PORT=3001

# PostgreSQL
DATABASE_URL=postgres://mjdm:CHANGE_ME@localhost:5432/mjdm_cloud

# 32+ random characters each, all different:  openssl rand -hex 48
JWT_SECRET=
JWT_REFRESH_SECRET=
SERVER_PEPPER=

# Browsers allowed to call the API with cookies (comma separated, exact origins)
CORS_ORIGINS=https://mjdm.us,https://admin.mjdm.us

# Admin account (the only way to become an admin; there is no sign-up). Generate all three with:
#   pnpm create-admin you@example.com
# Two-step verification (2FA) is OFF by default: login needs only the password. The admin can
# turn it on or off in the panel (Security tab). To ENFORCE 2FA from the server (it then cannot be
# turned off from the panel), also set ADMIN_TOTP_SECRET.
ADMIN_EMAIL=
ADMIN_PASSWORD_HASH=
# ADMIN_TOTP_SECRET=

# Where admin-edited website content is stored when no database is connected
# (with PostgreSQL it goes in the site_content table instead).
# SITE_CONTENT_FILE=./data/site-content.json

# License signing key pair (ES256 / P-256, PEM). Keep the private key on the server only; the
# public key is embedded in the desktop app. If unset a random key is generated on every start,
# which invalidates every license issued before.
ES256_PRIVATE_KEY_PEM=
ES256_PUBLIC_KEY_PEM=

# Payment webhooks
LEMON_SQUEEZY_WEBHOOK_SECRET=
POLAR_WEBHOOK_SECRET=
